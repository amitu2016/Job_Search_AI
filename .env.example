# Copy this to .env for local development. Never commit .env.
# On EC2, these are fetched from AWS SSM Parameter Store automatically.

JOB_AGENT_NAUKRI_USER=your_naukri_email
JOB_AGENT_NAUKRI_PASS=your_naukri_password

JOB_AGENT_OPENAI_KEY=sk-...

# Telegram bot — create via @BotFather, get chat_id by messaging your bot then calling getUpdates
JOB_AGENT_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
JOB_AGENT_TELEGRAM_CHAT_ID=your_chat_id

AWS_REGION=ap-south-1
